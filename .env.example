# Scrutexity local development configuration.
# Copy to .env. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Application connection. Runs as a non-owner role subject to RLS.
DATABASE_URL=postgres://scrutexity_app:scrutexity@127.0.0.1:5432/scrutexity
# Migration/owner connection, used only by scripts/migrate.ts.
DATABASE_ADMIN_URL=postgres://scrutexity_owner:scrutexity@127.0.0.1:5432/scrutexity

# Ed25519 signing key for evidence receipts (PKCS#8 PEM, base64-encoded).
# Generated by `make dev-keys` when absent; in production this is injected
# from a secret manager and never written to disk.
RECEIPT_SIGNING_KEY_ID=dev-local-1
RECEIPT_SIGNING_KEY_B64=

# Execution grant TTL: how long an ALLOW decision may be presented for
# execution before it must be re-evaluated.
EXECUTION_GRANT_TTL_SECONDS=300
# Default approval window for escalated decisions.
APPROVAL_TTL_SECONDS=3600
