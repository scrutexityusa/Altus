# Scrutexity local development configuration.
# Copy to .env. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Application connection. Runs as a non-owner role subject to RLS.
DATABASE_URL=postgres://scrutexity_app:scrutexity@127.0.0.1:5432/scrutexity
# Migration/owner connection, used only by scripts/migrate.ts.
DATABASE_ADMIN_URL=postgres://scrutexity_owner:scrutexity@127.0.0.1:5432/scrutexity

# Ed25519 signing key for evidence receipts (PKCS#8 PEM, base64-encoded).
# Generated in memory when absent, which is fine locally and refused in
# production -- receipts signed by a key that vanishes on restart verify today
# and fail tomorrow, which is worse than no receipts because they look like
# proof.
RECEIPT_SIGNING_KEY_ID=dev-local-1
RECEIPT_SIGNING_KEY_B64=

# Where private key material comes from.
#   env   the process environment. Fine locally, and the only provider that
#         needs no external system.
#   file  a file per secret under SECRET_DIR, so a secret can be mounted rather
#         than exported into a process environment that `ps` and crash dumps
#         can see.
#   kms   a key manager. The only provider production accepts, and setting
#         RECEIPT_SIGNING_KEY_B64 inline is a boot failure there.
# The name below is the environment variable, the filename, or the key manager's
# name for the key, depending on the provider. See ADR-0018.
SECRET_PROVIDER=env
SECRET_DIR=./.secrets
RECEIPT_SIGNING_KEY_NAME=RECEIPT_SIGNING_KEY_B64

# Whether a signal from a source with no enrolled key may influence authority.
#   required    an unenrolled source is refused. The default, and the only
#               value production accepts.
#   permissive  an unenrolled source presenting NO signature is accepted and
#               recorded as unauthenticated. A presented signature that cannot
#               be checked still fails, under every posture.
SIGNAL_AUTHENTICATION=required

# Whether HMAC-SHA256 signal keys work at all. `refused` by default in
# development as well as production: a fallback that exists locally is a
# fallback the tests exercise and production does not. Set `permitted` only
# while migrating a legacy source onto Ed25519.
SIGNAL_LEGACY_HMAC=refused

# Execution grant TTL: how long an ALLOW decision may be presented for
# execution before it must be re-evaluated.
EXECUTION_GRANT_TTL_SECONDS=300
# Default approval window for escalated decisions.
APPROVAL_TTL_SECONDS=3600
