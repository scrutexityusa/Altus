{
  "name": "scrutexity",
  "private": true,
  "version": "0.1.0",
  "description": "Machine authority and runtime authorization control plane",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@scrutexity/web build",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run services",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "spec:generate": "tsx scripts/generate-specs.ts",
    "spec:check": "tsx scripts/generate-specs.ts --check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "dev:api": "tsx watch services/api/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
